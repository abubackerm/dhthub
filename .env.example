# ===========================================
# DHT Hub - Environment Configuration
# ===========================================

# PostgreSQL Configuration
POSTGRES_USER=dht_admin
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=dht_hub
POSTGRES_PORT=5433

# Database URL for Prisma
DATABASE_URL="postgresql://dht_admin:your_secure_password@localhost:5433/dht_hub?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6380
REDIS_DB=0

# Cache TTL Configuration (in seconds)
CACHE_TTL_ATTRIBUTE_DEFINITION=3600
CACHE_TTL_ATTRIBUTE_OPTION=3600
CACHE_TTL_CATEGORY_ATTRIBUTE=1800
CACHE_TTL_UNIT_DEFINITION=7200

# API Configuration
API_PORT=3001
NODE_ENV=development

# Catalog Configuration
CATALOG_PRODUCT_LIMIT=25000

# Meilisearch Configuration
MEILISEARCH_HOST=http://127.0.0.1
MEILISEARCH_PORT=7700
MEILISEARCH_MASTER_KEY=your_meilisearch_master_key

# Minio Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_secure_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
