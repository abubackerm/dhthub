# ===========================================
# DHT Hub - Environment Configuration
# ===========================================

# PostgreSQL Configuration
POSTGRES_USER=dht_admin
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=dht_hub
POSTGRES_PORT=5433

# Database URL for Prisma
DATABASE_URL="postgresql://dht_admin:your_secure_password@localhost:5433/dht_hub?schema=public"

# Database Pool Configuration (per PM2 cluster worker)
# Each API cluster instance creates its own pool. Total connections = DB_POOL_MAX * instances + DB_AUTH_POOL_MAX * instances
# Default: 5 * 4 instances = 20 main + 3 * 4 = 12 auth = 32 total (safe for VPS)
DB_POOL_MAX=5
DB_AUTH_POOL_MAX=3

# Redis Configuration
REDIS_HOST=localhost
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6380
REDIS_DB=0
REDIS_MAXMEMORY=1gb

# Cache Versioning (bump to invalidate all keys when response shape changes)
CATALOG_CACHE_VERSION=1
PRODUCT_CACHE_VERSION=1

# Cache TTL Configuration (in seconds)
CACHE_TTL_ATTRIBUTE_DEFINITION=3600
CACHE_TTL_ATTRIBUTE_OPTION=3600
CACHE_TTL_CATEGORY_ATTRIBUTE=1800
CACHE_TTL_UNIT_DEFINITION=7200

# HTTP Cache TTL Configuration (in seconds)
# Applied to versioned catalog/product Redis read-through keys (Layer 4)
CACHE_TTL_CATEGORY_TREE=300
CACHE_TTL_CATEGORY_LEAF=120
CACHE_TTL_CATEGORY_CONSOLIDATED=120
CACHE_TTL_CATEGORY_FILTER=300
CACHE_TTL_PRODUCT_SLUG=120

# API Configuration
API_PORT=3001
NODE_ENV=development

# PM2 Cluster Configuration
# Number of API cluster instances (default: min(CPU cores, 4) for VPS)
# Set to 1 to run in single-process (fork) mode for debugging
PM2_API_INSTANCES=

# Catalog Configuration
CATALOG_PRODUCT_LIMIT=25000

# Next.js Configuration
NEXT_WEB_URL=http://localhost:3005

# Next.js On-Demand Revalidation
REVALIDATION_SECRET=your_revalidation_secret_here

# Cache Warming (post-deploy)
# Max priority URLs to warm after deploy (default: 10)
WARM_MAX_URLS=10

# Meilisearch Configuration
MEILISEARCH_HOST=http://127.0.0.1
MEILISEARCH_PORT=7700
MEILISEARCH_MASTER_KEY=your_meilisearch_master_key

# SeaweedFS Configuration
SEAWEDFS_S3_ACCESS_KEY=your_s3_access_key
SEAWEDFS_S3_SECRET_KEY=your_s3_secret_key
SEAWEDFS_S3_PORT=8333
SEAWEDFS_FILER_PORT=8888
SEAWEDFS_MASTER_PORT=9333
SEAWEDFS_VOLUME_PORT_START=8080

# SeaweedFS PostgreSQL Filer Store
SEAWEDFS_PG_SCHEMA=seaweedfs
SEAWEDFS_PG_HOST=dht-postgres
SEAWEDFS_PG_PORT=5432
SEAWEDFS_PG_USER=${POSTGRES_USER}
SEAWEDFS_PG_PASSWORD=${POSTGRES_PASSWORD}
SEAWEDFS_PG_DB=${POSTGRES_DB}

