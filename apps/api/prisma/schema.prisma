generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTH MODULE - User Management & Organizations
// ============================================

enum MembershipStatus {
  invited
  active
  suspended
  removed
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String?        @map("password_hash")
  name         String?
  isActive     Boolean        @default(true) @map("is_active")
  lastLoginAt  DateTime?      @map("last_login_at")
  emailVerified Boolean       @default(false) @map("email_verified")
  image        String?
  role         String         @default("user")
  banned       Boolean        @default(false)
  banReason    String?        @map("ban_reason")
  banExpires   DateTime?      @map("ban_expires")
  ownedOrgs    Organization[] @relation("OwnedOrganizations")
  memberships  Membership[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  createdBy    String?        @map("created_by")
  updatedBy    String?        @map("updated_by")
  sessions     Session[]
  accounts     Account[]

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  token          String   @unique
  expiresAt      DateTime @map("expires_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                     String   @id @default(cuid())
  userId                 String   @map("user_id")
  accountId              String   @map("account_id")
  providerId             String   @map("provider_id")
  accessToken            String?  @map("access_token")
  refreshToken           String?  @map("refresh_token")
  accessTokenExpiresAt   DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt  DateTime? @map("refresh_token_expires_at")
  scope                  String?
  idToken                String?  @map("id_token")
  password               String?  @map("password")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  ownerId     String       @map("owner_id")
  owner       User         @relation("OwnedOrganizations", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships Membership[]
  roles       Role[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  createdBy   String?      @map("created_by")
  updatedBy   String?      @map("updated_by")

  @@map("organizations")
}

model Membership {
  id             String           @id @default(cuid())
  userId         String           @map("user_id")
  organizationId String           @map("organization_id")
  roleId         String           @map("role_id")
  status         MembershipStatus @default(active)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role             @relation(fields: [roleId], references: [id])
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  createdBy      String?          @map("created_by")
  updatedBy      String?          @map("updated_by")

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Role {
  id             String       @id @default(cuid())
  name           String
  permissions    Json         @default("{}")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  createdBy      String?      @map("created_by")
  updatedBy      String?      @map("updated_by")

  @@unique([name, organizationId])
  @@map("roles")
}

// ============================================
// CATALOG MODULE - Product Catalog Management
// ============================================

enum ProductStatus {
  draft
  active
  archived
}

enum ProductType {
  simple
  variable
}

model Product {
  id             String        @id @default(cuid())
  version        Int           @default(0)
  sku            String?       @unique
  name           String
  slug           String        @unique
  description    String?
  type           ProductType   @default(simple)
  status         ProductStatus @default(draft)
  // TRANSITIONAL: Pricing moves to Pricing module
  price          Int?
  compareAtPrice Int?          @map("compare_at_price")
  costPrice      Int?          @map("cost_price")
  currency       String        @default("USD")
  // TRANSITIONAL: Stock moves to Inventory module
  quantity       Int           @default(0)
  cellId         String?       @map("cell_id")
  isFeatured     Boolean       @default(false) @map("is_featured")
  thumbnailUrl   String?       @map("thumbnail_url")
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  createdBy      String?       @map("created_by")
  updatedBy      String?       @map("updated_by")

  cell        Cell?              @relation(fields: [cellId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]
  images      ProductImage[]
  tableColumns ProductTableColumn[]

  @@index([status])
  @@index([cellId])
  @@index([sku])
  @@index([slug])
  @@index([createdAt])
  @@index([name])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String   @map("product_id")
  version        Int      @default(0)
  sku            String   @unique
  name           String
  // TRANSITIONAL: Pricing moves to Pricing module
  price          Int?
  compareAtPrice Int?     @map("compare_at_price")
  costPrice      Int?     @map("cost_price")
  quantity       Int      @default(0)
  // TRANSITIONAL: Will be replaced by AttributeDefinition system
  attributes     Json
  isDefault      Boolean  @default(false) @map("is_default")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")

  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  images          ProductImage[]
  variantImages   VariantImage[]
  attributeValues VariantAttributeValue[]
  prices          Price[]
  inventoryLevels InventoryLevel[]
  cartItems       CartItem[]
  enquiryItems    EnquiryItem[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model Category {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  parentId    String?          @map("parent_id")
  path        String           @unique
  sku         String?          @unique
  imageUrl    String?          @map("image_url")
  sortOrder   Int              @default(0) @map("sort_order")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  createdBy   String?          @map("created_by")
  updatedBy   String?          @map("updated_by")

  parent             Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children           Category[]          @relation("CategoryTree")
  cells              Cell[]
  categoryAttributes CategoryAttribute[]
  images             CategoryImage[]

  @@index([slug])
  @@index([parentId])
  @@index([path])
  @@index([path, isActive])
  @@index([sku])
  @@map("categories")
}

model CategoryImage {
  id          String   @id @default(cuid())
  categoryId  String   @map("category_id")
  sku         String
  storagePath String   @map("storage_path")
  position    Int      @map("position")
  altText     String?  @map("alt_text")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, position])
  @@index([sku])
  @@map("category_images")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  variantId String?  @map("variant_id")
  url       String
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([productId, sortOrder])
  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

model VariantImage {
  id          String   @id @default(cuid())
  variantId   String   @map("variant_id")
  sku         String
  storagePath String   @map("storage_path")
  position    Int      @map("position")
  altText     String?  @map("alt_text")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, position])
  @@index([sku])
  @@index([variantId, isPrimary])
  @@map("variant_images")
}

model ProductTableColumn {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  attributeId String   @map("attribute_id")
  unitId      String?  @map("unit_id")
  position    Int      @map("position")      // Order 1-15
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id])
  unit      UnitDefinition?     @relation(fields: [unitId], references: [id])

  @@unique([productId, position])
  @@unique([productId, attributeId])
  @@map("product_table_columns")
}

// ============================================
// ATTRIBUTE SYSTEM - Structured Product Attributes
// ============================================

enum AttributeDataType {
  number
  text
  enum
  boolean
}

enum AttributeFilterType {
  RANGE
  CHECKBOX
  SELECT
}

model AttributeDefinition {
  id           String               @id @default(cuid())
  name         String
  slug         String               @unique
  dataType     AttributeDataType    @map("data_type")
  group        String?              @map("group_name")
  sortOrder    Int                  @default(0) @map("sort_order")
  filterType   AttributeFilterType? @map("filter_type")
  isFilterable Boolean              @default(false) @map("is_filterable")
  isRequired   Boolean              @default(false) @map("is_required")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  createdBy    String?              @map("created_by")
  updatedBy    String?              @map("updated_by")

  options            AttributeOption[]
  values             VariantAttributeValue[]
  categoryAttributes CategoryAttribute[]
  cellAttributes     CellAttribute[]
  productTableColumns ProductTableColumn[]

  @@index([slug])
  @@index([dataType])
  @@index([group])
  @@map("attribute_definitions")
}

model AttributeOption {
  id          String   @id @default(cuid())
  attributeId String   @map("attribute_id")
  label       String
  value       String
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  attribute AttributeDefinition     @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  values    VariantAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("attribute_options")
}

model VariantAttributeValue {
  id          String   @id @default(cuid())
  variantId   String   @map("variant_id")
  attributeId String   @map("attribute_id")
  rawValue    String?  @map("raw_value")
  numberValue Float?   @map("number_value")
  textValue   String?  @map("text_value")
  optionId    String?  @map("option_id")
  booleanValue Boolean? @map("boolean_value")
  createdAt   DateTime @default(now()) @map("created_at")

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id])
  option    AttributeOption?    @relation(fields: [optionId], references: [id])

  @@unique([variantId, attributeId])
  @@index([variantId])
  @@index([attributeId])
  @@index([variantId, attributeId])
  @@index([attributeId, numberValue])
  @@index([attributeId, optionId])
  @@index([attributeId, booleanValue])
  @@map("variant_attribute_values")
}

model UnitDefinition {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  productTableColumns ProductTableColumn[]

  @@map("unit_definitions")
}

model CategoryAttribute {
  id          String   @id @default(cuid())
  categoryId  String   @map("category_id")
  attributeId String   @map("attribute_id")
  createdAt   DateTime @default(now()) @map("created_at")

  category  Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
  @@index([categoryId, attributeId])
  @@map("category_attributes")
}

// ============================================
// CELL MODULE - Cell Level in Catalog Hierarchy
// ============================================

model Cell {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  sku         String?  @unique
  description String?
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  categoryId  String   @map("category_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by")
  updatedBy   String?  @map("updated_by")

  category        Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products        Product[]
  cellAttributes  CellAttribute[]
  images          CellImage[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([categoryId, isActive, sortOrder])
  @@map("cells")
}

model CellImage {
  id          String   @id @default(cuid())
  cellId      String   @map("cell_id")
  sku         String
  storagePath String   @map("storage_path")
  position    Int      @map("position")
  altText     String?  @map("alt_text")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cell Cell @relation(fields: [cellId], references: [id], onDelete: Cascade)

  @@unique([cellId, position])
  @@index([sku])
  @@index([cellId, isPrimary])
  @@map("cell_images")
}

model CellAttribute {
  id           String   @id @default(cuid())
  cellId       String   @map("cell_id")
  attributeId  String   @map("attribute_id")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  cell      Cell                @relation(fields: [cellId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([cellId, attributeId])
  @@map("cell_attributes")
}

// ============================================
// PRICING MODULE - Tiered Pricing with Multi-Currency Support
// ============================================

model Currency {
  id        String  @id @default(uuid())
  code      String  @unique
  symbol    String
  decimals  Int     @default(2)

  prices    Price[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("currencies")
}

model Price {
  id          String   @id @default(uuid())

  variantId   String   @map("variant_id")
  currencyId  String   @map("currency_id")

  // Future-proof: Customer and regional pricing support
  customerGroupId String? @map("customer_group_id")
  regionId        String? @map("region_id")

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  currency    Currency       @relation(fields: [currencyId], references: [id])

  tiers       PriceTier[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([variantId, currencyId])
  @@index([variantId])
  @@map("prices")
}

model PriceTier {
  id        String  @id @default(uuid())

  priceId   String @map("price_id")
  minQty    Int    @map("min_qty")
  maxQty    Int?   @map("max_qty")
  unitPrice Decimal @db.Decimal(12,4) @map("unit_price")

  price     Price   @relation(fields: [priceId], references: [id], onDelete: Cascade)

  @@index([priceId])
  @@index([priceId, minQty])
  @@unique([priceId, minQty])
  @@map("price_tiers")
}

// ============================================
// INVENTORY MODULE - Stock Management & Reservations
// ============================================

model Warehouse {
  id        String @id @default(cuid())
  name      String
  code      String @unique
  location  String?

  inventoryLevels InventoryLevel[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("warehouses")
}

model InventoryLevel {
  id           String @id @default(cuid())

  variantId    String @map("variant_id")
  warehouseId  String @map("warehouse_id")

  availableQty Int @default(0) @map("available_qty")
  reservedQty  Int @default(0) @map("reserved_qty")
  safetyStock  Int @default(0) @map("safety_stock")

  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])

  movements    InventoryMovement[]
  reservations InventoryReservation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([variantId, warehouseId])
  @@index([variantId])
  @@index([warehouseId])
  @@map("inventory_levels")
}

model InventoryReservation {
  id            String @id @default(cuid())

  inventoryId   String @map("inventory_id")
  quantity      Int

  referenceId   String @map("reference_id")
  referenceType String @map("reference_type")
  status        String @default("ACTIVE") // ACTIVE, COMMITTED, RELEASED, EXPIRED

  expiresAt DateTime? @map("expires_at")

  inventory InventoryLevel @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([referenceId])
  @@index([referenceId, referenceType])
  @@map("inventory_reservations")
}

model InventoryMovement {
  id          String @id @default(cuid())

  inventoryId String @map("inventory_id")

  type        String // STOCK_IN, STOCK_OUT, ADJUSTMENT, RESERVATION, RELEASE
  quantity    Int
  reason      String? // MANUAL_ADJUSTMENT, IMPORT, RETURN, DAMAGED, WAREHOUSE_TRANSFER

  referenceId String? @map("reference_id")

  inventory InventoryLevel @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([inventoryId])
  @@map("inventory_movements")
}

// ============================================
// SHARED MODULE - Audit Trail System
// ============================================

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  performedBy String  @map("performed_by")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([occurredAt])
  @@map("audit_logs")
}

// ============================================
// IMPORT MODULE - Bulk Product Import Management
// ============================================

enum ImportFileType {
  CSV
  XLSX
  ZIP
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportMode {
  CREATE_ONLY
  UPSERT
  UPDATE_ONLY
}

enum ImportType {
  CATALOG
  ATTRIBUTES
  IMAGES
  CATEGORY_CREATE
  CATEGORY_UPDATE
  CATEGORY_EDIT
}

model ImportJob {
  id               String           @id @default(uuid())
  fileUrl          String           @map("file_url")
  fileName         String?          @map("file_name")
  fileSize         Int?             @map("file_size")
  type             ImportFileType
  status           ImportJobStatus  @default(PENDING)
  totalRows        Int?             @map("total_rows")
  processedRows    Int              @default(0) @map("processed_rows")
  successRows      Int              @default(0) @map("success_rows")
  failedRows       Int              @default(0) @map("failed_rows")
  lastProcessedRow Int              @default(0) @map("last_processed_row")
  lockedAt         DateTime?        @map("locked_at")
  lockedBy         String?          @map("locked_by")
  createdBy        String?          @map("created_by")
  mode             ImportMode?      @map("mode")
  warehouseId      String?          @map("warehouse_id")
  originalFilePath String?          @map("original_file_path")
  importType       ImportType?      @map("import_type")
  strategy         String?          @db.VarChar(10)
  startedAt        DateTime?        @map("started_at")
  finishedAt       DateTime?        @map("finished_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  errors           ImportError[]

  @@index([status])
  @@index([createdAt])
  @@index([lockedAt])
  @@map("import_jobs")
}

model ImportError {
  id        String   @id @default(uuid())
  jobId     String   @map("job_id")
  rowNumber Int      @map("row_number")
  sku       String?
  message   String
  rawData   Json?    @map("raw_data")
  sourceFile String?  @map("source_file")
  createdAt DateTime @default(now()) @map("created_at")

  job       ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("import_errors")
}

// ============================================
// CART MODULE - Shopping Cart Management
// ============================================

enum CartStatus {
  ACTIVE
  SUBMITTED
  ABANDONED
}

model Cart {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  isActive    Boolean     @default(true) @map("is_active")
  status      CartStatus  @default(ACTIVE) @map("status")
  submittedAt DateTime?   @map("submitted_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdBy   String?     @map("created_by")
  updatedBy   String?     @map("updated_by")

  items       CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String   @map("cart_id")
  variantId String   @map("variant_id")
  qty       Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

// ============================================
// ENQUIRY MODULE - RFQ Management
// ============================================

enum EnquiryStatus {
  SUBMITTED
  IN_PROGRESS
  QUOTED
  AWAITING_CONFIRMATION
  CONFIRMED
  PAYMENT_PENDING
  PAID
  PROCESSING
  IN_TRANSIT
  DELIVERED
}

model Enquiry {
  id            String        @id @default(cuid())
  enquiryNumber String?       @unique @map("enquiry_number")
  userId        String        @map("user_id")
  customerName  String        @map("customer_name")
  companyName   String?       @map("company_name")
  email         String
  phone         String?
  status        EnquiryStatus @default(SUBMITTED)
  grandTotal    Decimal?      @map("grand_total") @db.Decimal(12,2)
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  items     EnquiryItem[]

  @@index([userId])
  @@index([status])
  @@index([enquiryNumber])
  @@map("enquiries")
}

model EnquiryItem {
  id        String   @id @default(cuid())
  enquiryId String   @map("enquiry_id")
  variantId String   @map("variant_id")
  productId String  @map("product_id")
  sku       String
  price     Decimal? @db.Decimal(12,2)
  total     Decimal? @db.Decimal(12,2)
  qty       Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  enquiry Enquiry        @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@index([variantId])
  @@index([productId])
  @@map("enquiry_items")
}
