<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Enquiry Status Update</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f4f4; font-family: Arial, Helvetica, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f4f4f4; padding: 30px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">

          <!-- Header -->
          <tr>
            <td style="background-color: #1a1a2e; padding: 30px 40px; text-align: center;">
              <h1 style="margin: 0; color: #ffffff; font-size: 24px; font-weight: 700; letter-spacing: 1px;">DHT</h1>
              <p style="margin: 6px 0 0 0; color: #c0392b; font-size: 13px; text-transform: uppercase; letter-spacing: 2px;">Enquiry Update</p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding: 35px 40px;">
              <p style="margin: 0 0 6px 0; font-size: 16px; color: #333333;">Hi <strong>{{customerName}}</strong>,</p>
              <p style="margin: 0 0 24px 0; font-size: 15px; color: #555555; line-height: 1.6;">The status of your enquiry has been updated.</p>

              <!-- Status Change -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
                <tr>
                  <td style="text-align: center;">
                    <table role="presentation" cellpadding="0" cellspacing="0" style="display: inline-block;">
                      <tr>
                        <td style="background-color: #e8e8e8; border-radius: 20px; padding: 10px 22px;">
                          <span style="font-size: 14px; color: #666666; font-weight: 600;">{{formatStatus previousStatus}}</span>
                        </td>
                        <td style="padding: 0 12px; vertical-align: middle;">
                          <span style="font-size: 18px; color: #c0392b; font-weight: 700;">&rarr;</span>
                        </td>
                        <td style="background-color: #c0392b; border-radius: 20px; padding: 10px 22px;">
                          <span style="font-size: 14px; color: #ffffff; font-weight: 600;">{{formatStatus newStatus}}</span>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Enquiry Details -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f9f9f9; border-radius: 6px; border: 1px solid #e8e8e8;">
                <tr>
                  <td style="padding: 14px 18px; border-bottom: 1px solid #e8e8e8; width: 160px;">
                    <span style="font-size: 13px; color: #888888; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Enquiry</span>
                  </td>
                  <td style="padding: 14px 18px; border-bottom: 1px solid #e8e8e8;">
                    <span style="font-size: 15px; color: #333333; font-weight: 600;">#{{enquiryNumber}}</span>
                  </td>
                </tr>
                <tr>
                  <td style="padding: 14px 18px;">
                    <span style="font-size: 13px; color: #888888; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Updated On</span>
                  </td>
                  <td style="padding: 14px 18px;">
                    <span style="font-size: 14px; color: #666666;">{{formatDate updatedAt}}</span>
                  </td>
                </tr>
              </table>

              {{#if notes}}
              <!-- Notes -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top: 20px;">
                <tr>
                  <td>
                    <p style="margin: 0 0 8px 0; font-size: 13px; color: #888888; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Notes</p>
                    <div style="background-color: #f9f9f9; border: 1px solid #e8e8e8; border-radius: 6px; padding: 18px;">
                      <p style="margin: 0; font-size: 15px; color: #333333; line-height: 1.6; white-space: pre-wrap;">{{notes}}</p>
                    </div>
                  </td>
                </tr>
              </table>
              {{/if}}

              <p style="margin: 24px 0 0 0; font-size: 14px; color: #555555; line-height: 1.6;">If you have any questions about your enquiry, please don't hesitate to contact us.</p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #1a1a2e; padding: 20px 40px; text-align: center;">
              <p style="margin: 0; font-size: 12px; color: #999999;">&copy; {{formatDate updatedAt "year"}} DHT. All rights reserved.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
