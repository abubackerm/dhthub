<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Enquiry Received</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f4f4; font-family: Arial, Helvetica, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f4f4f4; padding: 30px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">

          <!-- Header -->
          <tr>
            <td style="background-color: #1a1a2e; padding: 30px 40px; text-align: center;">
              <h1 style="margin: 0; color: #ffffff; font-size: 24px; font-weight: 700; letter-spacing: 1px;">DHT</h1>
              <p style="margin: 6px 0 0 0; color: #c0392b; font-size: 13px; text-transform: uppercase; letter-spacing: 2px;">New Enquiry</p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding: 35px 40px;">
              <p style="margin: 0 0 20px 0; font-size: 16px; color: #333333;">A new enquiry has been submitted on the DHT website.</p>

              <!-- Customer Details -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f9f9f9; border-radius: 6px; border: 1px solid #e8e8e8;">
                <tr>
                  <td style="padding: 14px 18px; border-bottom: 1px solid #e8e8e8; width: 160px;">
                    <span style="font-size: 13px; color: #888888; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Customer</span>
                  </td>
                  <td style="padding: 14px 18px; border-bottom: 1px solid #e8e8e8;">
                    <span style="font-size: 15px; color: #333333; font-weight: 600;">{{customerName}}</span>
                  </td>
                </tr>
                <tr>
                  <td style="padding: 14px 18px; border-bottom: 1px solid #e8e8e8;">
                    <span style="font-size: 13px; color: #888888; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Email</span>
                  </td>
                  <td style="padding: 14px 18px; border-bottom: 1px solid #e8e8e8;">
                    <a href="mailto:{{customerEmail}}" style="font-size: 15px; color: #c0392b; text-decoration: none;">{{customerEmail}}</a>
                  </td>
                </tr>
                {{#if companyName}}
                <tr>
                  <td style="padding: 14px 18px; border-bottom: 1px solid #e8e8e8;">
                    <span style="font-size: 13px; color: #888888; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Company</span>
                  </td>
                  <td style="padding: 14px 18px; border-bottom: 1px solid #e8e8e8;">
                    <span style="font-size: 15px; color: #333333;">{{companyName}}</span>
                  </td>
                </tr>
                {{/if}}
                <tr>
                  <td style="padding: 14px 18px; border-bottom: 1px solid #e8e8e8;">
                    <span style="font-size: 13px; color: #888888; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Enquiry #</span>
                  </td>
                  <td style="padding: 14px 18px; border-bottom: 1px solid #e8e8e8;">
                    <span style="font-size: 15px; color: #333333; font-weight: 600;">{{enquiryNumber}}</span>
                  </td>
                </tr>
                <tr>
                  <td style="padding: 14px 18px; border-bottom: 1px solid #e8e8e8;">
                    <span style="font-size: 13px; color: #888888; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Items</span>
                  </td>
                  <td style="padding: 14px 18px; border-bottom: 1px solid #e8e8e8;">
                    <span style="font-size: 15px; color: #333333;">{{itemCount}}</span>
                  </td>
                </tr>
                {{#if grandTotal}}
                <tr>
                  <td style="padding: 14px 18px; border-bottom: 1px solid #e8e8e8;">
                    <span style="font-size: 13px; color: #888888; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Grand Total</span>
                  </td>
                  <td style="padding: 14px 18px; border-bottom: 1px solid #e8e8e8;">
                    <span style="font-size: 15px; color: #333333; font-weight: 600;">SAR {{grandTotal}}</span>
                  </td>
                </tr>
                {{/if}}
                <tr>
                  <td style="padding: 14px 18px;">
                    <span style="font-size: 13px; color: #888888; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">Submitted</span>
                  </td>
                  <td style="padding: 14px 18px;">
                    <span style="font-size: 14px; color: #666666;">{{formatDate createdAt}}</span>
                  </td>
                </tr>
              </table>

              {{#if items.length}}
              <!-- Items Table -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top: 24px; border: 1px solid #e8e8e8; border-radius: 6px; overflow: hidden;">
                <tr>
                  <td style="background-color: #1a1a2e; padding: 10px 14px; font-size: 12px; color: #ffffff; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600;">SKU</td>
                  <td style="background-color: #1a1a2e; padding: 10px 14px; font-size: 12px; color: #ffffff; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; text-align: center;">Qty</td>
                  <td style="background-color: #1a1a2e; padding: 10px 14px; font-size: 12px; color: #ffffff; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; text-align: right;">Price</td>
                  <td style="background-color: #1a1a2e; padding: 10px 14px; font-size: 12px; color: #ffffff; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; text-align: right;">Total</td>
                </tr>
                {{#each items}}
                <tr>
                  <td style="padding: 10px 14px; font-size: 14px; color: #333333; border-bottom: 1px solid #e8e8e8;">{{sku}}</td>
                  <td style="padding: 10px 14px; font-size: 14px; color: #333333; text-align: center; border-bottom: 1px solid #e8e8e8;">{{quantity}}</td>
                  <td style="padding: 10px 14px; font-size: 14px; color: #333333; text-align: right; border-bottom: 1px solid #e8e8e8;">{{#if price}}SAR {{price}}{{else}}--{{/if}}</td>
                  <td style="padding: 10px 14px; font-size: 14px; color: #333333; text-align: right; border-bottom: 1px solid #e8e8e8;">{{#if total}}SAR {{total}}{{else}}--{{/if}}</td>
                </tr>
                {{/each}}
              </table>
              {{/if}}
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #1a1a2e; padding: 20px 40px; text-align: center;">
              <p style="margin: 0; font-size: 12px; color: #999999;">&copy; {{formatDate createdAt "year"}} DHT. All rights reserved.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
