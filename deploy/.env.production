# ===========================================
# DHT Hub - Production Environment
# ===========================================
# Copy this file to /opt/dynamic_hub/.env and fill in secure values

# PostgreSQL Configuration
POSTGRES_USER=dht_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=dht_hub
POSTGRES_PORT=5433

# Database URL for Prisma
DATABASE_URL="postgresql://dht_admin:CHANGE_ME_STRONG_PASSWORD@localhost:5433/dht_hub?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6380
REDIS_DB=0

# Cache TTL Configuration (in seconds)
CACHE_TTL_ATTRIBUTE_DEFINITION=3600
CACHE_TTL_ATTRIBUTE_OPTION=3600
CACHE_TTL_CATEGORY_ATTRIBUTE=1800
CACHE_TTL_UNIT_DEFINITION=7200

# API Configuration
API_PORT=3001
NODE_ENV=production
API_URL=http://localhost:3001

# Web URL (for CORS)
WEB_URL=https://www.verdeum.in

# Catalog Configuration
CATALOG_PRODUCT_LIMIT=25000

# Meilisearch Configuration
MEILISEARCH_HOST=http://127.0.0.1
MEILISEARCH_PORT=7700
MEILISEARCH_MASTER_KEY=CHANGE_ME_MEILI_MASTER_KEY

# SeaweedFS Configuration
SEAWEDFS_S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
SEAWEDFS_S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
SEAWEDFS_S3_PORT=8333
SEAWEDFS_FILER_PORT=8888
SEAWEDFS_MASTER_PORT=9333
SEAWEDFS_VOLUME_PORT_START=8080

# SeaweedFS PostgreSQL Filer Store
SEAWEDFS_PG_SCHEMA=seaweedfs
SEAWEDFS_PG_HOST=localhost
SEAWEDFS_PG_PORT=5433
SEAWEDFS_PG_USER=dht_admin
SEAWEDFS_PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEAWEDFS_PG_DB=dht_hub

# Better Auth
BETTER_AUTH_SECRET=CHANGE_ME_BETTER_AUTH_SECRET_MIN_32_CHARS

# Microsoft Graph API (for email sending)
MS_TENANT_ID=a915d563-bbdc-4f45-b4f9-432515505834
MS_CLIENT_ID=49dcfded-3bbf-4da2-adbb-e24b2bb6fa89
MS_CLIENT_SECRET=CHANGE_ME_MS_CLIENT_SECRET

# Email Settings
EMAIL_FROM=no-reply@dht-sa.com
EMAIL_FROM_NAME=DHT
EMAIL_ADMIN_RECIPIENT=abubackerm22@gmail.com

# reCAPTCHA (server-side secret only)
RECAPTCHA_SECRET_KEY=
SKIP_RECAPTCHA=true
